# Copy to .env for local development (this file is read from backend/../.env,
# i.e. the repo root, so one .env file serves both frontend and backend).
# Full environment variable contract lives in the repo root .env.example.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Point this at your local PostgreSQL instance/database.
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/repomind_ai
