# =====================================================================
# RepoMind AI - Environment Variable Contract
# =====================================================================
# This file documents every config value the system will need across
# all development phases. Copy to `.env` and fill in real values.
# NEVER commit the real `.env` file.
#
# Not every variable below is used yet - they are added here as a
# reference so we don't invent ad-hoc env vars later. Each is used
# starting on the day noted in the comment.
# =====================================================================

# ---------------------------------------------------------------------
# Backend - FastAPI (used from Day 3)
# ---------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Auth / Security (used from Day 5)
# ---------------------------------------------------------------------
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------
# PostgreSQL (used from Day 4)
# ---------------------------------------------------------------------
POSTGRES_USER=repomind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=repomind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://repomind:changeme@localhost:5432/repomind

# ---------------------------------------------------------------------
# GitHub API (used from Day 6)
# ---------------------------------------------------------------------
# Optional but recommended: raises GitHub's unauthenticated rate limit
# from 60 req/hr to 5000 req/hr. Create a read-only personal access
# token with no special scopes for public repo access.
GITHUB_TOKEN=

# ---------------------------------------------------------------------
# Qdrant - Vector Database (used from Day 15)
# ---------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=repomind_code_chunks

# ---------------------------------------------------------------------
# Embeddings / LLM Provider (used from Day 14)
# ---------------------------------------------------------------------
# We build a provider abstraction, so only one of these blocks is
# required depending on which provider we wire up first.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------
# Redis / Background Workers (used from Day 34)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Frontend - Next.js (used from Day 2)
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# Repository ingestion limits (used from Day 6-7)
# ---------------------------------------------------------------------
MAX_REPO_SIZE_MB=250
MAX_FILE_SIZE_KB=500
