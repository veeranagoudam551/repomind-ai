# =====================================================================
# RepoMind AI - Environment Variable Contract
# =====================================================================
# This file documents every config value the system will need across
# all development phases. Copy to `.env` and fill in real values.
# NEVER commit the real `.env` file.
#
# Not every variable below is used yet - they are added here as a
# reference so we don't invent ad-hoc env vars later. Each is used
# starting on the day noted in the comment.
# =====================================================================

# ---------------------------------------------------------------------
# Backend - FastAPI (used from Day 3)
# ---------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# development | production - production enables a startup guard (Day 47:
# app/core/config.py) that refuses to run with a still-placeholder
# JWT_SECRET_KEY or DATABASE_URL password, and disables SQL echo logging
# regardless of LOG_LEVEL.
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API (CORS). Set to
# your real frontend origin(s) in production - the localhost default
# logs a startup warning (not a hard failure - a same-origin/reverse-
# proxy setup may not need CORS configured at all) if left unchanged
# with ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Auth / Security (used from Day 5)
# ---------------------------------------------------------------------
# The placeholder below is fine for local dev - it's what lets a fresh
# checkout boot with zero configuration - but generate a real random
# value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
# before setting ENVIRONMENT=production; the app refuses to start
# otherwise (Day 47).
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------
# PostgreSQL (used from Day 4)
# ---------------------------------------------------------------------
POSTGRES_USER=repomind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=repomind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://repomind:changeme@localhost:5432/repomind

# ---------------------------------------------------------------------
# GitHub API (used from Day 6)
# ---------------------------------------------------------------------
# Optional but recommended: raises GitHub's unauthenticated rate limit
# from 60 req/hr to 5000 req/hr. Create a read-only personal access
# token with no special scopes for public repo access.
GITHUB_TOKEN=

# ---------------------------------------------------------------------
# Qdrant - Vector Database (used from Day 15)
# ---------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=repomind_code_chunks

# ---------------------------------------------------------------------
# Embeddings / LLM Provider (embeddings used from Day 14, chat from Day 17)
# ---------------------------------------------------------------------
# Anthropic has no embeddings endpoint, so these are always two separate
# providers regardless of LLM_PROVIDER: OpenAI (or, since Day 51, a local
# model) is used for embeddings, ANTHROPIC_* for the chat model that
# answers questions.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# EMBEDDING_PROVIDER (Day 51): "openai" (default - unchanged since Day 14)
# or "local" (app/services/embedding_providers.py's fastembed/ONNX
# provider, runs in-process, no API key, no OpenAI credits needed - useful
# for demoing without spending API credits). OPENAI_API_KEY below is only
# ever read when this is "openai"; EMBEDDING_MODEL likewise only applies
# to that provider. Changing this after a repository has already been
# ingested does NOT retroactively re-embed it - the two providers use
# separate Qdrant collections (never mixed dimensions in one), so a
# repository ingested under one provider is only searchable after
# switching if it's re-ingested (POST .../reindex) under the new one.
#
# "local" needs fastembed installed, which backend/requirements.txt
# deliberately does NOT include (Day 51's review - keeps the default,
# lightweight "openai" install/image free of its ~150MB dependency tree).
# Native/WSL: `pip install -r backend/requirements-local-embedding.txt`
# instead of requirements.txt. Docker Compose `full` profile: set
# BACKEND_DOCKER_TARGET below.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Only read when EMBEDDING_PROVIDER=local. Any fastembed-supported model
# name; downloaded and cached at runtime on first use (not committed to
# git, not baked into the Docker image) - never during startup unless
# EMBEDDING_PROVIDER is actually "local".
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Docker Compose "full" profile only (used from Day 51) - which build
# target backend/Dockerfile uses for the api/celery-worker images: read
# by docker-compose.yml itself, not by the application. "production"
# (default) installs only requirements.txt - fine for EMBEDDING_PROVIDER=
# openai. Set to "with-local-embedding" (and rebuild:
# `--profile full up -d --build`) only if EMBEDDING_PROVIDER=local above -
# otherwise you're paying for fastembed's dependency tree in the image
# for a provider you're not using.
BACKEND_DOCKER_TARGET=production

# ---------------------------------------------------------------------
# Redis / Background Workers (used from Day 34)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Frontend - Next.js (used from Day 2)
# ---------------------------------------------------------------------
# Native/WSL development only: the frontend (`next dev`/`next start`)
# and backend (`uvicorn`) run as separate processes on the same host
# here, so localhost:8000 is correct. Do NOT change this to point at
# docker/docker-compose.yml's `api` service - see
# COMPOSE_FRONTEND_API_BASE_URL below for that case instead; reusing
# this same variable for both was a real Day 47 bug (the frontend
# container couldn't reach `localhost:8000` from inside itself).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Docker Compose "full" profile only (used from Day 47) - leave unset
# unless you specifically need the full profile's frontend container to
# reach a backend somewhere other than docker-compose.yml's own `api`
# service (e.g. a real public domain in an actual deployment). Next.js
# bakes NEXT_PUBLIC_API_BASE_URL into the build at build time, and the
# frontend's server-side code runs *inside the frontend container* -
# `docker compose --profile full up -d` builds the frontend with this
# value (falling back to http://api:8000, the Compose-internal service
# name, if left blank here) rather than reusing NEXT_PUBLIC_API_BASE_URL
# above, which would resolve to the frontend container itself instead
# of the backend. See docker/docker-compose.yml's frontend service for
# the full explanation.
COMPOSE_FRONTEND_API_BASE_URL=

# ---------------------------------------------------------------------
# Repository ingestion limits (used from Day 6-7)
# ---------------------------------------------------------------------
MAX_REPO_SIZE_MB=250
MAX_FILE_SIZE_KB=500

# ---------------------------------------------------------------------
# Code chunking (used from Day 8)
# ---------------------------------------------------------------------
# Sliding line-window size for splitting a file into code_chunks, and
# how many lines consecutive chunks overlap by (preserves context that
# would otherwise be cut at a window boundary).
CHUNK_MAX_LINES=100
CHUNK_OVERLAP_LINES=15

# ---------------------------------------------------------------------
# Rate limiting (used from Day 46)
# ---------------------------------------------------------------------
# Redis-backed fixed-window counters (reuses REDIS_URL above). Each
# *_LIMIT/*_WINDOW_SECONDS pair is one scope; RATE_LIMIT_ENABLED=false
# disables all of them (e.g. for a firewalled internal deployment).
# ingestion: POST /repositories, POST /repositories/{id}/reindex
# ai: search/chat/debug/architecture/security-scan/explain/review
# agent: POST /repositories/{id}/agent (up to max_steps LLM calls/request)
# auth_register / auth_login: POST /auth/register, POST /auth/login
# (IP-based, not per-user - there's no user yet) - windows are an hour,
# not a minute, since this is the one IP-scoped pair and a short window
# sized for a single user would make automated/CI testing flaky.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_INGESTION_LIMIT=20
RATE_LIMIT_INGESTION_WINDOW_SECONDS=3600
RATE_LIMIT_AI_LIMIT=20
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AGENT_LIMIT=5
RATE_LIMIT_AGENT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REGISTER_LIMIT=30
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_LOGIN_LIMIT=40
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=3600

# ---------------------------------------------------------------------
# Production deployment (used from Day 47)
# ---------------------------------------------------------------------
# Read by backend/docker-entrypoint.sh, not by the app itself - only
# relevant when running the backend's Dockerfile (or otherwise via
# `uvicorn --workers`/`--forwarded-allow-ips` directly).
#
# WEB_CONCURRENCY: uvicorn worker process count. No single right answer -
# a common starting point is (2 x CPU cores) + 1, tuned from there.
WEB_CONCURRENCY=2
# FORWARDED_ALLOW_IPS: which upstream IPs uvicorn trusts X-Forwarded-For/
# X-Forwarded-Proto from (needed for the app to see the real client IP,
# and for Day 46's per-IP auth rate limiting specifically to work
# correctly, behind a reverse proxy). "*" trusts any upstream - fine
# when the proxy is the only thing that can reach the backend at all
# (e.g. Docker Compose's internal network, nothing else routes to it);
# set to the proxy's actual IP/CIDR if the backend is ever directly
# reachable from anywhere else.
FORWARDED_ALLOW_IPS=*
