# =====================================================================
# RepoMind AI - Environment Variable Contract
# =====================================================================
# This file documents every config value the system will need across
# all development phases. Copy to `.env` and fill in real values.
# NEVER commit the real `.env` file.
#
# Not every variable below is used yet - they are added here as a
# reference so we don't invent ad-hoc env vars later. Each is used
# starting on the day noted in the comment.
# =====================================================================

# ---------------------------------------------------------------------
# Backend - FastAPI (used from Day 3)
# ---------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------
# Auth / Security (used from Day 5)
# ---------------------------------------------------------------------
JWT_SECRET_KEY=changeme-generate-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------
# PostgreSQL (used from Day 4)
# ---------------------------------------------------------------------
POSTGRES_USER=repomind
POSTGRES_PASSWORD=changeme
POSTGRES_DB=repomind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://repomind:changeme@localhost:5432/repomind

# ---------------------------------------------------------------------
# GitHub API (used from Day 6)
# ---------------------------------------------------------------------
# Optional but recommended: raises GitHub's unauthenticated rate limit
# from 60 req/hr to 5000 req/hr. Create a read-only personal access
# token with no special scopes for public repo access.
GITHUB_TOKEN=

# ---------------------------------------------------------------------
# Qdrant - Vector Database (used from Day 15)
# ---------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=repomind_code_chunks

# ---------------------------------------------------------------------
# Embeddings / LLM Provider (embeddings used from Day 14, chat from Day 17)
# ---------------------------------------------------------------------
# Anthropic has no embeddings endpoint, so these are always two separate
# providers regardless of LLM_PROVIDER: OpenAI is used for embeddings,
# ANTHROPIC_* for the chat model that answers questions.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------
# Redis / Background Workers (used from Day 34)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Frontend - Next.js (used from Day 2)
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# Repository ingestion limits (used from Day 6-7)
# ---------------------------------------------------------------------
MAX_REPO_SIZE_MB=250
MAX_FILE_SIZE_KB=500

# ---------------------------------------------------------------------
# Code chunking (used from Day 8)
# ---------------------------------------------------------------------
# Sliding line-window size for splitting a file into code_chunks, and
# how many lines consecutive chunks overlap by (preserves context that
# would otherwise be cut at a window boundary).
CHUNK_MAX_LINES=100
CHUNK_OVERLAP_LINES=15

# ---------------------------------------------------------------------
# Rate limiting (used from Day 46)
# ---------------------------------------------------------------------
# Redis-backed fixed-window counters (reuses REDIS_URL above). Each
# *_LIMIT/*_WINDOW_SECONDS pair is one scope; RATE_LIMIT_ENABLED=false
# disables all of them (e.g. for a firewalled internal deployment).
# ingestion: POST /repositories, POST /repositories/{id}/reindex
# ai: search/chat/debug/architecture/security-scan/explain/review
# agent: POST /repositories/{id}/agent (up to max_steps LLM calls/request)
# auth_register / auth_login: POST /auth/register, POST /auth/login
# (IP-based, not per-user - there's no user yet) - windows are an hour,
# not a minute, since this is the one IP-scoped pair and a short window
# sized for a single user would make automated/CI testing flaky.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_INGESTION_LIMIT=20
RATE_LIMIT_INGESTION_WINDOW_SECONDS=3600
RATE_LIMIT_AI_LIMIT=20
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AGENT_LIMIT=5
RATE_LIMIT_AGENT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REGISTER_LIMIT=30
RATE_LIMIT_AUTH_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_AUTH_LOGIN_LIMIT=40
RATE_LIMIT_AUTH_LOGIN_WINDOW_SECONDS=3600
